---
layout: null
permalink: /quotes.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }} — Sözler</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <atom:link href="{{ "/quotes.xml" | absolute_url }}" rel="self" type="application/rss+xml" />
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll</generator>
    {% for post in site.posts %}
    {% if post.post-type == "quote" %}
    <item>
      <title>{{ post.content | strip_html | strip_newlines | strip | xml_escape }}</title>
      <description>{{ post.content | strip_html | strip_newlines | strip | xml_escape }}</description>
      <link>{{ post.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
    </item>
    {% endif %}
    {% endfor %}
  </channel>
</rss>
