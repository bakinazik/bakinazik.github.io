---
layout: null
permalink: /quotes.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }} — Sözler</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <atom:link href="{{ "/quotes.xml" | absolute_url }}" rel="self" type="application/rss+xml" />
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll</generator>
    {% assign feed_quotes = site.quotes | sort: "date" | reverse %}
    {% for quote in feed_quotes %}
    <item>
      <title>{{ quote.content | strip_html | strip_newlines | xml_escape }}</title>
      <description>{{ quote.content | strip_html | strip_newlines | xml_escape }}</description>
      <link>{{ quote.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ quote.url | absolute_url }}</guid>
    </item>
    {% endfor %}
  </channel>
</rss>
