---
layout: null
permalink: /quotes.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }} — Sözler</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <atom:link href="{{ "/quotes.xml" | absolute_url }}" rel="self" type="application/rss+xml" />
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll</generator>
    {% for quote in site.data.quotes %}
    <item>
      <title>{{ quote.text | strip_html | xml_escape }}</title>
      <description>{{ quote.text | strip_html | xml_escape }}</description>
      <link>{{ site.url }}{{ site.baseurl }}/quotes/?=quote-{{ forloop.index0 }}</link>
      <guid isPermaLink="false">{{ site.url }}{{ site.baseurl }}/quote-{{ forloop.index0 }}</guid>
    </item>
    {% endfor %}
  </channel>
</rss>
